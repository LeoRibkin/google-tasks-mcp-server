# Configuration for google-tasks-mcp-server. Placeholder values only.
# On Vercel, set these under Project > Settings > Environment Variables.
# For local testing you may copy this file to .env, but NEVER commit a real .env file.

# Required. Long random string: letters, digits, "-" and "_" only; at least 16, ideally 32+ characters.
# It is part of your private connector URL: https://<your-app>.vercel.app/tasks/<TASKS_PATH_SECRET>/mcp
TASKS_PATH_SECRET=replace-with-a-long-random-string

# Required. From your Google Cloud OAuth client (Google Auth Platform > Clients).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Required. Shown once on the page you reach after clicking "Connect Google account" on your setup page.
GOOGLE_REFRESH_TOKEN=paste-the-value-from-your-setup-page

# Optional. Only needed with a custom domain. Default: the project's production *.vercel.app address.
# PUBLIC_BASE_URL=https://tasks.example.com

# Optional. Lets the setup page link straight to your project's environment variables.
# VERCEL_DASHBOARD_URL=https://vercel.com/<your-team>/<your-project>
